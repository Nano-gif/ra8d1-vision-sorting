# This file is included by the RT-Thread Studio generated Debug/makefile
# before rtthread.elf is defined.
#
# Keep the Edge Impulse exported SDK out of CDT Managed Build. The same
# sources are built through script/build_ei_v15_sdk.ps1 into libei_v15_sdk.a
# from makefile.targets. Letting CDT compile edge_impulse_export directly
# reintroduces CMSIS-DSP TransformFunctions MVE build failures.

EI_V15_MANAGED_EXPORT_BUILD_PREFIX := Components/edge_impulse_v15/edge_impulse_export/
EI_V15_MANAGED_EXPORT_OBJ_PREFIX := ./$(EI_V15_MANAGED_EXPORT_BUILD_PREFIX)
EI_V15_MANAGED_EXPORT_SRC_PREFIX := ../$(EI_V15_MANAGED_EXPORT_BUILD_PREFIX)
EI_V15_MANAGED_EXPORT_OBJS := $(filter $(EI_V15_MANAGED_EXPORT_OBJ_PREFIX)%,$(OBJS))

OBJS := $(filter-out $(EI_V15_MANAGED_EXPORT_OBJS),$(OBJS))

C_SRCS := $(filter-out $(EI_V15_MANAGED_EXPORT_SRC_PREFIX)%,$(C_SRCS))
CC_SRCS := $(filter-out $(EI_V15_MANAGED_EXPORT_SRC_PREFIX)%,$(CC_SRCS))
CPP_SRCS := $(filter-out $(EI_V15_MANAGED_EXPORT_SRC_PREFIX)%,$(CPP_SRCS))
CXX_SRCS := $(filter-out $(EI_V15_MANAGED_EXPORT_SRC_PREFIX)%,$(CXX_SRCS))
C++_SRCS := $(filter-out $(EI_V15_MANAGED_EXPORT_SRC_PREFIX)%,$(C++_SRCS))

C_DEPS := $(filter-out $(EI_V15_MANAGED_EXPORT_BUILD_PREFIX)%,$(C_DEPS))
CC_DEPS := $(filter-out $(EI_V15_MANAGED_EXPORT_BUILD_PREFIX)%,$(CC_DEPS))
CPP_DEPS := $(filter-out $(EI_V15_MANAGED_EXPORT_BUILD_PREFIX)%,$(CPP_DEPS))
CXX_DEPS := $(filter-out $(EI_V15_MANAGED_EXPORT_BUILD_PREFIX)%,$(CXX_DEPS))
C++_DEPS := $(filter-out $(EI_V15_MANAGED_EXPORT_BUILD_PREFIX)%,$(C++_DEPS))

APP_CPP_SMOKE_OBJ := ./APP/cpp_smoke_probe.o
ifeq ($(filter $(APP_CPP_SMOKE_OBJ),$(OBJS)),)
CPP_SRCS += ../APP/cpp_smoke_probe.cpp
OBJS += $(APP_CPP_SMOKE_OBJ)
CPP_DEPS += ./APP/cpp_smoke_probe.d

$(APP_CPP_SMOKE_OBJ): ../APP/cpp_smoke_probe.cpp
	arm-none-eabi-g++ -mthumb -mfloat-abi=hard -mfpu=fpv5-sp-d16 -march=armv8.1-m.main+mve.fp+fp.dp -O0 -ffunction-sections -fdata-sections -Wall -g -gdwarf-2 -I"../APP" -include"../rtconfig_preinc.h" -std=gnu++11 -fabi-version=0 -fno-exceptions -fno-rtti -MMD -MP -MF"$(@:%.o=%.d)" -MT"$(@)" -c -o "$@" "$<"
endif

APP_RS485_OBJ := ./APP/rs485_app.o
ifeq ($(filter $(APP_RS485_OBJ),$(OBJS)),)
C_SRCS += ../APP/rs485_app.c
OBJS += $(APP_RS485_OBJ)
C_DEPS += ./APP/rs485_app.d
endif

