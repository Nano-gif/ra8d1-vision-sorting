SOFT_SPI_OBJ := ./Components/soft_spi/soft_spi.o
ifeq ($(filter $(SOFT_SPI_OBJ),$(OBJS)),)
C_SRCS += ../Components/soft_spi/soft_spi.c
OBJS += $(SOFT_SPI_OBJ)
C_DEPS += ./Components/soft_spi/soft_spi.d

$(SOFT_SPI_OBJ): ../Components/soft_spi/soft_spi.c
	@mkdir -p Components/soft_spi
	arm-none-eabi-gcc -mthumb -mfloat-abi=hard -mfpu=fpv5-sp-d16 -march=armv8.1-m.main+mve.fp+fp.dp -O0 -ffunction-sections -fdata-sections -Wall  -g -gdwarf-2 -I"../APP" -I".." -I"../Components" -I"../rt-thread/include" -I"../rt-thread/components/drivers/include" -I"../rt-thread/components/finsh" -I"../rt-thread/libcpu/arm/common" -I"../rt-thread/libcpu/arm/cortex-m85" -I"../ra/arm/CMSIS_5/CMSIS/Core/Include" -I"../ra/fsp/inc/api" -I"../ra/fsp/inc/instances" -I"../ra/fsp/inc" -I"../ra_cfg/fsp_cfg/bsp" -I"../ra_cfg/fsp_cfg" -I"../ra_gen" -include"../rtconfig_preinc.h" -std=gnu11 -MMD -MP -MF"$(@:%.o=%.d)" -MT"$(@)" -c -o "$@" "$<"
endif

W5500_ETHERNET_OBJS := ./Components/Ethernet/wizchip_conf.o ./Components/Ethernet/socket.o ./Components/Ethernet/W5500/w5500.o
W5500_ETHERNET_MISSING_OBJS := $(filter-out $(OBJS),$(W5500_ETHERNET_OBJS))
ifneq ($(strip $(W5500_ETHERNET_MISSING_OBJS)),)
C_SRCS += $(patsubst ./%,../%.c,$(W5500_ETHERNET_MISSING_OBJS:%.o=%))
OBJS += $(W5500_ETHERNET_MISSING_OBJS)
C_DEPS += $(W5500_ETHERNET_MISSING_OBJS:%.o=%.d)

./Components/Ethernet/%.o: ../Components/Ethernet/%.c
	@mkdir -p Components/Ethernet
	arm-none-eabi-gcc -mthumb -mfloat-abi=hard -mfpu=fpv5-sp-d16 -march=armv8.1-m.main+mve.fp+fp.dp -O0 -ffunction-sections -fdata-sections -Wall  -g -gdwarf-2 -I"../APP" -I".." -I"../Components" -I"../Components/Ethernet" -I"../Components/Ethernet/W5500" -I"../rt-thread/include" -I"../rt-thread/components/drivers/include" -I"../rt-thread/components/finsh" -I"../rt-thread/libcpu/arm/common" -I"../rt-thread/libcpu/arm/cortex-m85" -I"../ra/arm/CMSIS_5/CMSIS/Core/Include" -I"../ra/fsp/inc/api" -I"../ra/fsp/inc/instances" -I"../ra/fsp/inc" -I"../ra_cfg/fsp_cfg/bsp" -I"../ra_cfg/fsp_cfg" -I"../ra_gen" -include"../rtconfig_preinc.h" -std=gnu11 -MMD -MP -MF"$(@:%.o=%.d)" -MT"$(@)" -c -o "$@" "$<"

./Components/Ethernet/W5500/%.o: ../Components/Ethernet/W5500/%.c
	@mkdir -p Components/Ethernet/W5500
	arm-none-eabi-gcc -mthumb -mfloat-abi=hard -mfpu=fpv5-sp-d16 -march=armv8.1-m.main+mve.fp+fp.dp -O0 -ffunction-sections -fdata-sections -Wall  -g -gdwarf-2 -I"../APP" -I".." -I"../Components" -I"../Components/Ethernet" -I"../Components/Ethernet/W5500" -I"../rt-thread/include" -I"../rt-thread/components/drivers/include" -I"../rt-thread/components/finsh" -I"../rt-thread/libcpu/arm/common" -I"../rt-thread/libcpu/arm/cortex-m85" -I"../ra/arm/CMSIS_5/CMSIS/Core/Include" -I"../ra/fsp/inc/api" -I"../ra/fsp/inc/instances" -I"../ra/fsp/inc" -I"../ra_cfg/fsp_cfg/bsp" -I"../ra_cfg/fsp_cfg" -I"../ra_gen" -include"../rtconfig_preinc.h" -std=gnu11 -MMD -MP -MF"$(@:%.o=%.d)" -MT"$(@)" -c -o "$@" "$<"
endif

